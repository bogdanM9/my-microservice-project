# Copy this file to terraform.tfvars, paste your GitHub token, and you are done.
#
# terraform.tfvars is listed in .gitignore. Never commit it.

github_username = "bogdanM9"
github_repo_url = "https://github.com/bogdanM9/my-microservice-project.git"

# Paste the Personal Access Token here. It needs the repo scope.
github_token    = "PASTE_YOUR_GITHUB_TOKEN_HERE"

