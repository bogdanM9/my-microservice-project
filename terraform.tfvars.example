# Copy this file to terraform.tfvars, paste your GitHub token, and you are done.
#
# terraform.tfvars is listed in .gitignore. Never commit it.

github_username = "bogdanM9"
github_repo_url = "https://github.com/bogdanM9/my-microservice-project.git"

# Paste the Personal Access Token here. It needs the repo scope.
github_token    = "PASTE_YOUR_GITHUB_TOKEN_HERE"

# Everything below already has a sensible default, uncomment only to change it.
# region                = "eu-central-1"
# cluster_name          = "lesson-8-9-eks"
# instance_type         = "m7i-flex.large"
# git_branch            = "lesson-8-9"
# repository_name       = "django-app"

# --------------------------------------------------------------------------
# Database, handled by modules/rds
#
# Leave these commented and you get a single db.t3.micro PostgreSQL instance,
# which is free tier eligible. Uncomment the Aurora block instead to get a
# cluster. Nothing else in the project changes either way.
# --------------------------------------------------------------------------
# use_aurora            = false
# db_engine             = "postgres"
# db_engine_version     = "16"      # a prefix, or leave it out for the newest
# db_instance_class     = "db.t3.micro"
# db_multi_az           = false
# db_name               = "appdb"
# db_username           = "dbadmin"

# Aurora PostgreSQL, one writer and one reader:
# use_aurora            = true
# db_engine             = "aurora-postgresql"
# db_engine_version     = "16"      # a prefix, or leave it out for the newest
# db_instance_class     = "db.t3.medium"
# aurora_replica_count  = 1

# MySQL instead of PostgreSQL:
# db_engine             = "mysql"
# db_engine_version     = "8.0"

# The master password is generated by the module, so it is not set here.
# Read it after the apply with: terraform output -raw db_master_password
